# Unified Agent Configuration for Python Projects
# WhiteSource/Mend configuration file

##########################################################################################
# GENERAL SCAN MODE: Files and Package Managers
##########################################################################################

checkPolicies=false
forceCheckAllDependencies=false
forceUpdate=false
forceUpdate.failBuildOnPolicyViolation=false
offline=false

##########################################################################################
# Python Settings
##########################################################################################

python.resolveDependencies=true
python.ignorePipInstallErrors=true
python.installVirtualenv=true
python.resolveHierarchyTree=false
python.requirementsFileIncludes=requirements*.txt
python.resolveSetupPyFiles=true
python.runPipenvPreStep=true
python.pipenvDevDependencies=true
python.IgnorePipenvInstallErrors=true
python.resolveGlobalPackages=false
python.localPackagePathsToInstall=
python.resolvePipEditablePackages=true
python.path=python3
python.pipPath=pip3
python.runPoetryPreStep=true
python.includePoetryDevDependencies=true

##########################################################################################
# General Settings (Disable other language scanners)
##########################################################################################

npm.resolveDependencies=false
bower.resolveDependencies=false
nuget.resolveDependencies=false
maven.resolveDependencies=false
gradle.resolveDependencies=false
go.resolveDependencies=false
ruby.resolveDependencies=false
sbt.resolveDependencies=false
php.resolveDependencies=false
r.resolveDependencies=false
cargo.resolveDependencies=false
hex.resolveDependencies=false
cocoapods.resolveDependencies=false
swift.resolveDependencies=false

##########################################################################################
# Organization and Product Details
##########################################################################################

# These will be provided by the pipeline
#apiKey=
#productName=
#projectName=

##########################################################################################
# Scan Settings
##########################################################################################

excludes=**/*test* **/*Test* **/tests/** **/test/** **/.venv/** **/venv/** **/__pycache__/** **/.pytest_cache/** **/.mypy_cache/** **/.tox/** **/htmlcov/** **/site-packages/**

includes=**/*.py **/*.txt **/*.in **/*.cfg **/*.toml **/*.lock

case.sensitive.glob=false
followSymbolicLinks=true

##########################################################################################
# Log Settings
##########################################################################################

log.level=info
#log.files.level=debug
#log.files.path=

##########################################################################################
# Project Coordinates (for multi-module projects)
##########################################################################################

#projectTag=
#projectToken=
projectVersion=

##########################################################################################
# Proxy Settings (if needed)
##########################################################################################

#proxy.host=
#proxy.port=
#proxy.user=
#proxy.pass=

##########################################################################################
# SCM Settings (optional)
##########################################################################################

#scm.type=
#scm.user=
#scm.pass=
#scm.ppk=
#scm.url=
#scm.branch=
#scm.tag=

##########################################################################################
# SAST Settings (if applicable)
##########################################################################################

#sast.resolveDependencies=false

##########################################################################################
# Vulnerability Settings
##########################################################################################

checkVulnerabilities=true
vulnerabilitiesScoreFilter=0

##########################################################################################
# License Settings
##########################################################################################

checkLicenses=true