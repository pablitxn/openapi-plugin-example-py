# Environment
ENVIRONMENT=development

# Bypass settings for development
BYPASS_AUTH=true
USE_FILESYSTEM_STORAGE=true
FILESYSTEM_STORAGE_PATH=./mock_storage

# Security settings (use dummy values for local development)
SECURITY_CLIENT_ID=dummy-client-id
SECURITY_API_AUDIENCE=api://dummy-audience

# OpenAI settings (optional - add your key if you want to test AI features)
# OPENAI_API_KEY=your-key-here

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379/0

# Azure Storage (not needed if using filesystem storage)
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# Application Insights (optional - for telemetry)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string