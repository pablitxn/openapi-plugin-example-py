{
  "environment": "development",
  "api_prefix": "/api/plugin/ExamplePlugin",
  "api_version": "v1",
  "security": {
    "tenant_id": "5b973f99-77df-4beb-b27d-aa0c70b8482c",
    "client_id": "${CLIENT_ID}",
    "api_audience": "api://${CLIENT_ID}",
    "client_secret": "${clientSecret}",
    "geney_client_id": "${GENEY_CLIENT_ID}",
    "geney_api_domain": "${GENEY_API_DOMAIN}"
  },
  "telemetry": {
    "enabled": true,
    "connection_string": "${APPLICATIONINSIGHTS_CONNECTION_STRING}",
    "service_name": "ExamplePlugin"
  },
  "plugin_options": {
    "plugin_name": "ExamplePlugin",
    "is_enabled_full_tracking": false,
    "prompts": {
      "Sample": {
        "system_prompt": "You are a sample prompting execution agent. You must provide helpful and accurate responses.",
        "user_prompt": "Please provide a sample response for the following sample prompt: {{sample_prompt}}."
      },
      "AISample": {
        "system_prompt": "You are an AI assistant specialized in providing detailed explanations.",
        "user_prompt": "{{sample_prompt}}"
      }
    },
    "schemas": {
      "sample": "{\"type\":\"object\",\"properties\":{\"SampleResponse\":{\"type\":\"string\",\"description\":\"This is the sample response from the provided sample prompt\"}},\"required\":[\"SampleResponse\"],\"additionalProperties\":false}",
      "ai_sample": "{\"type\":\"object\",\"properties\":{\"AIResponse\":{\"type\":\"string\",\"description\":\"The AI-generated response\"},\"Confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1}},\"required\":[\"AIResponse\"],\"additionalProperties\":false}"
    },
    "cache": {
      "enabled": true,
      "redis_url": "redis://localhost:6379",
      "ttl_seconds": 3600
    },
    "azure_openai": {
      "api_key": "${AZURE_OPENAI_API_KEY}",
      "endpoint": "${AZURE_OPENAI_ENDPOINT}",
      "deployment_name": "${AZURE_OPENAI_DEPLOYMENT_NAME}",
      "api_version": "2024-02-01",
      "temperature": 0.7,
      "max_tokens": 1000
    },
    "max_file_size_mb": 10,
    "processing_timeout_seconds": 30,
    "supported_file_types": ["pdf", "txt", "docx", "json", "csv", "xlsx"]
  }
}