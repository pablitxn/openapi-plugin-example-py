{
  "environment": "development",
  "bypass_auth": true,
  "use_filesystem_storage": true,
  "filesystem_storage_path": "./mock_storage",
  "security": {
    "geney_api_domain": "https://api-dev.geney.example.com"
  },
  "telemetry": {
    "enabled": false
  },
  "plugin_options": {
    "is_enabled_full_tracking": true,
    "schemas": {
      "sample": "{\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}}}",
      "ai_sample": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"string\"}}}"
    },
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "max_tokens": 1000
    },
    "azure_openai": {
      "api_key": "${AZURE_OPENAI_API_KEY:test-key}",
      "endpoint": "${AZURE_OPENAI_ENDPOINT:https://test.openai.azure.com}",
      "deployment_name": "${AZURE_OPENAI_DEPLOYMENT_NAME:gpt-4}",
      "api_version": "2024-02-01",
      "temperature": 0.7,
      "max_tokens": 1000
    }
  },
  "blob_storage": {
    "connection_string": "${AZURE_STORAGE_CONNECTION_STRING}",
    "default_container": "dev-uploads",
    "sas_token_expiry_hours": 1,
    "max_upload_size_mb": 50
  },
  "redis_url": "redis://localhost:6379/0",
  "cors_origins": ["http://localhost:3000", "http://localhost:8080"]
}