{
  "info": {
    "name": "OpenAPI Plugin Example",
    "description": "Collection for testing OpenAPI Plugin Example endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Health check endpoint - no authentication required"
      }
    },
    {
      "name": "Sample Endpoint",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-chat-id",
            "value": "{{chat_id}}",
            "type": "text"
          },
          {
            "key": "x-agent-id",
            "value": "{{agent_id}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/plugin/ExamplePlugin/v1/sample?sample_input=Hello World&use_cache=true",
          "host": ["{{base_url}}"],
          "path": ["api", "plugin", "ExamplePlugin", "v1", "sample"],
          "query": [
            {
              "key": "sample_input",
              "value": "Hello World",
              "description": "The sample input to process (required)"
            },
            {
              "key": "use_cache",
              "value": "true",
              "description": "Whether to use cache (optional, default: true)"
            }
          ]
        },
        "description": "Process a sample request and return a processed response"
      }
    },
    {
      "name": "AI Sample Endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-chat-id",
            "value": "{{chat_id}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sample_prompt\": \"Explain quantum computing in simple terms\",\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/plugin/ExamplePlugin/v1/ai-sample",
          "host": ["{{base_url}}"],
          "path": ["api", "plugin", "ExamplePlugin", "v1", "ai-sample"]
        },
        "description": "Generate AI response using OpenAI"
      }
    },
    {
      "name": "Blob Upload Endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-chat-id",
            "value": "{{chat_id}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_name\": \"test-document.pdf\",\n  \"file_content_base64\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/plugin/ExamplePlugin/v1/blob-sample",
          "host": ["{{base_url}}"],
          "path": ["api", "plugin", "ExamplePlugin", "v1", "blob-sample"]
        },
        "description": "Upload a file to Azure Blob Storage. The example includes a base64-encoded test PDF."
      }
    },
    {
      "name": "Create Plot Endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-chat-id",
            "value": "{{chat_id}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"excel_url\": \"https://storage.azure.com/data/sales_data.xlsx\",\n  \"plot_type\": \"bar\",\n  \"x_column\": \"Month\",\n  \"y_column\": \"Sales\",\n  \"title\": \"Monthly Sales Report\",\n  \"sheet_name\": \"Sheet1\",\n  \"figure_size\": [10, 6]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/plugin/ExamplePlugin/v1/create-plot",
          "host": ["{{base_url}}"],
          "path": ["api", "plugin", "ExamplePlugin", "v1", "create-plot"]
        },
        "description": "Create a plot from Excel data. Downloads Excel from blob storage, creates a plot using matplotlib, and returns the URL of the generated image."
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add any pre-request scripts here",
          "// For example, to refresh JWT token before each request"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add common tests here",
          "pm.test(\"Status code is not 401\", function () {",
          "    pm.expect(pm.response.code).to.not.equal(401);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "chat_id",
      "value": "chat-123",
      "type": "string"
    },
    {
      "key": "agent_id",
      "value": "agent-456",
      "type": "string"
    }
  ]
}